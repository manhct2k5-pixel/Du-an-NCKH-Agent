# Copy to .env and enter your own API key locally.
FRAUD_LLM_PROVIDER=ds2api
DS2API_API_BASE=http://127.0.0.1:5001/v1
DS2API_API_KEY=
FRAUD_LLM_MODEL=deepseek-v4-flash

# Official DeepSeek API: FRAUD_LLM_PROVIDER=deepseek,
# DEEPSEEK_API_KEY=... and FRAUD_LLM_MODEL=deepseek-flash.

# To use OpenAI instead, set FRAUD_LLM_PROVIDER=openai,
# FRAUD_LLM_MODEL=gpt-4.1-mini and OPENAI_API_KEY in .env.
